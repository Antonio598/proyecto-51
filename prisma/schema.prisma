// ─────────────────────────────────────────────────────────────
// Esquema de datos COMPLETO del CRM de Seguros de Flotas.
// Se define entero desde la Fase A para no requerir migraciones
// destructivas al implementar los módulos posteriores.
// El módulo de SINIESTROS queda RESERVADO (stub) — sin lógica en
// esta fase, pero con la relación Poliza -> Siniestro[] lista.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

// Supabase: `url` usa el pooler (pgBouncer, puerto 6543) para el runtime,
// y `directUrl` la conexión directa (puerto 5432) que Prisma necesita para migrar.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Rol {
  captura
  tecnico
  comercial
  administracion
  admin
}

enum EstadoExpediente {
  vacio
  en_captura
  en_analisis_tecnico
  en_revision_comercial
  ajustado
  aprobado
  enviado_a_cliente
}

enum TipoUnidad {
  camion
  tractocamion
  remolque
  otro
}

enum TipoDocumento {
  recibido
  comparativo
  propuesta
  desglose
  poliza
  factura
  complemento
  comprobante_pago
}

enum OrigenDocumento {
  whatsapp
  generado
  manual_upload
  portal
}

enum EstadoRevision {
  pendiente
  aprobado
  corregido
}

enum EstadoPoliza {
  pendiente_emision
  emitida
  cancelada
}

enum EstadoCobranza {
  vigente
  por_vencer
  vencido
  pagado
}

enum FormaPago {
  transferencia
  efectivo
  cheque
  tarjeta
  otro
}

// Periodicidad de pago (la "forma de pago" del cliente): determina cuántas
// parcialidades tiene el plan y cada cuántos meses vencen. NO confundir con
// FormaPago (que es el MÉTODO de pago: transferencia/efectivo/…).
enum Periodicidad {
  de_contado
  mensual
  bimestral
  trimestral
}

// Movimiento de un endoso: alta (nueva unidad/póliza), baja o cancelación.
enum MovimientoEndoso {
  alta
  baja
  cancelacion
}

// ───────────────────────── Usuarios ─────────────────────────

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expedientesCreados Expediente[] @relation("ExpedienteCreadoPor")
  extraccionesRevisadas Extraccion[] @relation("ExtraccionRevisadaPor")
  comentarios  Comentario[]
  pagosRegistrados Pago[]        @relation("PagoRegistradoPor")
  auditLogs    AuditLog[]
  notificaciones Notificacion[]
}

// Notificaciones internas del sistema (p. ej. "el comparativo está listo para revisión").
// Se dirigen a un usuario concreto o a todos los de un rol.
model Notificacion {
  id           String      @id @default(cuid())
  usuarioId    String?
  usuario      User?       @relation(fields: [usuarioId], references: [id])
  rolDestino   Rol?
  titulo       String
  mensaje      String
  enlace       String?
  leida        Boolean     @default(false)
  expedienteId String?
  expediente   Expediente? @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([usuarioId, leida])
  @@index([rolDestino, leida])
}

// ───────────────────────── Clientes y flotas ─────────────────────────

model Cliente {
  id             String   @id @default(cuid())
  razonSocial    String
  // RFC: llave principal para identificar y agrupar al cliente. Único cuando
  // existe (Postgres admite múltiples NULL). Se normaliza en mayúsculas.
  rfc            String?  @unique
  datosFiscales  Json?    // dirección fiscal, régimen, uso CFDI, etc.
  contactoNombre String?
  contactoEmail  String?
  // Número de WhatsApp normalizado (E.164). Clave del match automático de mensajes entrantes.
  whatsappNumber String?  @unique
  notas          String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unidades     Unidad[]
  flotas       Flota[]
  expedientes  Expediente[]
  polizas      Poliza[]
  polizasMadre PolizaMadre[]
  documentos   Documento[]
  facturas     Factura[]
  notasCredito NotaCredito[]

  @@index([razonSocial])
}

// Una flota agrupa unidades de un mismo cliente. Un cliente puede tener varias
// (p. ej. por asegurado, por archivo entregado o por identificador/folio). Se
// crean automáticamente al extraer los documentos que sube el cliente.
model Flota {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  folio     String? // identificador/folio de la flota, si el archivo lo trae
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidades Unidad[]

  @@index([clienteId])
}

model Unidad {
  id             String     @id @default(cuid())
  clienteId      String
  cliente        Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  flotaId        String?
  flota          Flota?     @relation(fields: [flotaId], references: [id], onDelete: SetNull)
  folio          String?    // folio de la unidad; se liga a la póliza correspondiente
  tipo           TipoUnidad @default(otro)
  aseguradoNombre String?   // nombre del asegurado que aparece en el layout
  vin            String?    // número de serie
  anio           Int?
  marca          String?
  modelo         String?
  descripcion    String?    // descripción completa de la unidad
  numeroEconomico String?
  placas         String?
  numeroMotor    String?
  tipoCarga      String?    // tipo de carga / descripción de la mercancía
  usoUnidad      String?    // particular | carga privada | carga federal
  tipoCobertura  String?    // amplia | limitada | rc | ...
  dobleRemolque  Boolean    @default(false)
  valorAsegurado Decimal?   @db.Decimal(14, 2) // suma asegurada de la unidad
  // Adaptación / equipo especial montado sobre la unidad.
  tipoAdaptacion         String?
  coberturaAdaptacion    String?   // se liga a la cobertura de la unidad
  sumaAseguradaAdaptacion Decimal? @db.Decimal(14, 2)
  // Absorbe cualquier columna del "vaciado en Excel" del despacho sin cambiar el esquema.
  camposExtra    Json?
  activo         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  polizas Poliza[]

  @@index([clienteId])
  @@index([flotaId])
  @@index([vin])
}

// ───────────────────────── Aseguradoras ─────────────────────────

model Aseguradora {
  id         String   @id @default(cuid())
  nombre     String   @unique
  contacto   String?
  notasPortal String? // notas del orden de captura del portal (para checklists)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propuestas   PropuestaAseguradora[]
  polizas      Poliza[]
  polizasMadre PolizaMadre[]
}

// ───────────────────────── Expediente (flujo) ─────────────────────────

model Expediente {
  id          String           @id @default(cuid())
  folioInterno String          @unique @default(cuid())
  clienteId   String
  cliente     Cliente          @relation(fields: [clienteId], references: [id])
  estado      EstadoExpediente @default(en_captura)
  // Siniestralidad que aporta el cliente; alimenta el análisis técnico.
  siniestralidad String?
  // IDs de aseguradoras a las que se solicitó propuesta. Cuando todas están
  // capturadas, el comparativo se genera automáticamente sin paso manual.
  aseguradorasSolicitadas String[] @default([])
  createdById String?
  createdBy   User?            @relation("ExpedienteCreadoPor", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  propuestasAseguradora PropuestaAseguradora[]
  comparativos          Comparativo[]
  propuestaCliente      PropuestaCliente?
  polizas               Poliza[]
  documentos            Documento[]
  comentarios           Comentario[]
  notificaciones        Notificacion[]

  @@index([clienteId])
  @@index([estado])
}

model Comentario {
  id           String     @id @default(cuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  autorId      String
  autor        User       @relation(fields: [autorId], references: [id])
  contenido    String
  createdAt    DateTime   @default(now())

  @@index([expedienteId])
}

// ───────────────────────── Documentos ─────────────────────────

model Documento {
  id            String          @id @default(cuid())
  clienteId     String?
  cliente       Cliente?        @relation(fields: [clienteId], references: [id])
  expedienteId  String?
  expediente    Expediente?     @relation(fields: [expedienteId], references: [id])
  polizaId      String?
  poliza        Poliza?         @relation(fields: [polizaId], references: [id])
  tipo          TipoDocumento
  origen        OrigenDocumento
  storageKey    String          // clave del objeto en MinIO/S3
  mime          String?
  nombreOriginal String?
  procesado     Boolean         @default(false) // bandeja: origen=whatsapp AND procesado=false
  metadata      Json?           // datos del mensaje de WhatsApp de origen, etc.
  createdAt     DateTime        @default(now())

  extraccion Extraccion?

  @@index([clienteId])
  @@index([origen, procesado])
}

// ───────────────────────── Extracción IA ─────────────────────────

model Extraccion {
  id                String         @id @default(cuid())
  documentoId       String         @unique
  documento         Documento      @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  camposExtraidos   Json           // { vin, anio, marca, modelo, ... }
  confianzaPorCampo Json           // { vin: 0.98, anio: 0.4, ... }
  estadoRevision    EstadoRevision @default(pendiente)
  revisadoPorId     String?
  revisadoPor       User?          @relation("ExtraccionRevisadaPor", fields: [revisadoPorId], references: [id])
  modeloUsado       String?
  createdAt         DateTime       @default(now())
  revisadoEn        DateTime?

  @@index([estadoRevision])
}

// ───────────────────────── Técnico: propuestas y comparativo ─────────────────────────

model PropuestaAseguradora {
  id            String      @id @default(cuid())
  expedienteId  String
  expediente    Expediente  @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  aseguradoraId String
  aseguradora   Aseguradora @relation(fields: [aseguradoraId], references: [id])
  coberturas    Json        // estructurado, no texto libre
  prima         Decimal?    @db.Decimal(14, 2)
  deducibles    Json?
  condiciones   String?
  siniestralidad String?    // dato aportado por el cliente
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([expedienteId, aseguradoraId])
  @@index([expedienteId])
}

model Comparativo {
  id           String     @id @default(cuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  datosTabla   Json       // matriz de coberturas/prima/deducibles por aseguradora
  pdfDocId     String?
  excelDocId   String?
  generadoEn   DateTime   @default(now())

  @@index([expedienteId])
}

model PropuestaCliente {
  id           String     @id @default(cuid())
  expedienteId String     @unique
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  contenido    Json       // resumen, alcance de cobertura, costos, condiciones
  pdfDocId     String?
  enviadaEn    DateTime?
  createdAt    DateTime   @default(now())
}

// ───────────────────────── Pólizas ─────────────────────────

model Poliza {
  id             String       @id @default(cuid())
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  unidadId       String
  unidad         Unidad       @relation(fields: [unidadId], references: [id])
  aseguradoraId  String
  aseguradora    Aseguradora  @relation(fields: [aseguradoraId], references: [id])
  expedienteId   String?
  expediente     Expediente?  @relation(fields: [expedienteId], references: [id])
  // Póliza Madre a la que pertenece esta hija/endoso (una Madre por cliente+aseguradora).
  polizaMadreId  String?
  polizaMadre    PolizaMadre? @relation(fields: [polizaMadreId], references: [id], onDelete: SetNull)
  folio          String?      // folio de la aseguradora (capturado o extraído por IA)
  vigenciaInicio DateTime?
  vigenciaFin    DateTime?
  prima          Decimal?     @db.Decimal(14, 2)
  // Cobranza: se capturan a mano (no hay API con la aseguradora). El desglose por
  // hija vive aquí; el total de la Madre es la suma de sus hijas.
  primaNeta        Decimal? @db.Decimal(14, 2)
  financiamiento   Decimal? @db.Decimal(14, 2) // recargo/tasa de financiamiento por pago diferido
  gastosExpedicion Decimal? @db.Decimal(14, 2)
  iva              Decimal? @db.Decimal(14, 2)
  primaTotal       Decimal? @db.Decimal(14, 2)
  numeroPagos      Int?
  estado         EstadoPoliza @default(pendiente_emision)
  // Endosos: fecha de cancelación (baja) y bandera de alta por endoso (para
  // pintar la cobranza en rojo/verde). La póliza cancelada NO se borra.
  canceladaEn    DateTime?
  altaPorEndoso  Boolean      @default(false)
  pdfDocId       String?
  // Liga externa (Dropbox/nube) al PDF de la póliza. El técnico la registra a
  // mano; no hay API con la aseguradora. Alternativa a subir el archivo.
  urlNube        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cortes     Corte[]
  pagos      Pago[]
  documentos Documento[]
  facturas   Factura[]
  endosos    Endoso[]
  // RESERVADO para el módulo futuro de Siniestros (sin lógica en esta fase).
  siniestros Siniestro[]

  @@index([clienteId])
  @@index([estado])
  @@index([polizaMadreId])
}

// ───────────────────────── Póliza Madre (cobranza consolidada) ─────────────────────────
// Concentra la cobranza de un cliente en una aseguradora. Agrupa sus pólizas
// hijas/endosos y lleva el plan de pagos (periodicidad + parcialidades). El
// importe que se cobra al cliente = total de la Madre (suma de sus hijas).
model PolizaMadre {
  id            String       @id @default(cuid())
  clienteId     String
  cliente       Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  aseguradoraId String
  aseguradora   Aseguradora  @relation(fields: [aseguradoraId], references: [id])
  periodicidad  Periodicidad @default(mensual)
  numeroPagos   Int          @default(12) // derivado de la periodicidad (1|12|6|4)
  fechaEmision  DateTime? // ancla del plan (primera emisión de una hija)
  primeraFechaPago DateTime? // = fechaEmision + 10 días naturales
  // Totales consolidados (suma de las hijas; se recalculan al capturar cobranza).
  primaNeta        Decimal? @db.Decimal(14, 2)
  financiamiento   Decimal? @db.Decimal(14, 2)
  gastosExpedicion Decimal? @db.Decimal(14, 2)
  iva              Decimal? @db.Decimal(14, 2)
  primaTotal       Decimal? @db.Decimal(14, 2)
  // Cuando es true, los totales de arriba se capturaron a mano en la Madre y NO
  // se sobrescriben con la suma de las hijas.
  totalesManual Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  hijas  Poliza[]
  cortes CorteMadre[]

  @@unique([clienteId, aseguradoraId])
  @@index([clienteId])
}

// Una parcialidad del plan de pagos de la Madre. Reemplaza a Corte (por póliza)
// como unidad de calendario de cobranza. El primer pago carga financiamiento +
// gastos de expedición; los subsecuentes solo prima neta proporcional + IVA.
model CorteMadre {
  id               String         @id @default(cuid())
  polizaMadreId    String
  polizaMadre      PolizaMadre    @relation(fields: [polizaMadreId], references: [id], onDelete: Cascade)
  numeroParcialidad Int           // 1..numeroPagos
  periodo          String         // "2026-08"
  fechaCorte       DateTime
  fechaVencimiento DateTime       // fecha límite de pago de esta parcialidad
  montoEsperado    Decimal?       @db.Decimal(14, 2)
  esPrimerPago     Boolean        @default(false)
  // Fecha de vencimiento editada a mano: la regeneración no la sobrescribe.
  fechaManual      Boolean        @default(false)
  estado           EstadoCobranza @default(vigente)
  pagadoEn         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  pagos         Pago[]
  recordatorios RecordatorioCobranza[]

  @@unique([polizaMadreId, numeroParcialidad])
  @@index([estado])
  @@index([fechaVencimiento])
}

// Historial de recordatorios de cobranza enviados por correo. La `clave`
// (p. ej. "d20", "d15", "c3:2") identifica el hito/cadencia y hace idempotente
// el envío: el cron no repite un recordatorio ya mandado para esa parcialidad.
model RecordatorioCobranza {
  id            String     @id @default(cuid())
  corteMadreId  String
  corteMadre    CorteMadre @relation(fields: [corteMadreId], references: [id], onDelete: Cascade)
  clave         String
  canal         String     @default("correo")
  destino       String?
  asunto        String?
  diasRestantes Int?
  enviadoEn     DateTime   @default(now())

  @@unique([corteMadreId, clave])
  @@index([corteMadreId])
}

// ───────────────────────── Cobranza recurrente ─────────────────────────

model Corte {
  id              String         @id @default(cuid())
  polizaId        String
  poliza          Poliza         @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  periodo         String         // p.ej. "2026-07"
  fechaCorte      DateTime
  fechaProximoPago DateTime      // fechaCorte + 30 días naturales
  montoEsperado   Decimal?       @db.Decimal(14, 2)
  estado          EstadoCobranza @default(vigente)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  pagos Pago[]

  @@unique([polizaId, periodo])
  @@index([estado])
  @@index([fechaProximoPago])
}

model Pago {
  id               String     @id @default(cuid())
  polizaId         String
  poliza           Poliza     @relation(fields: [polizaId], references: [id])
  corteId          String?
  corte            Corte?     @relation(fields: [corteId], references: [id])
  // Parcialidad de la Madre a la que se aplica (unidad de cobranza vigente).
  corteMadreId     String?
  corteMadre       CorteMadre? @relation(fields: [corteMadreId], references: [id])
  fecha            DateTime
  monto            Decimal    @db.Decimal(14, 2)
  forma            FormaPago  @default(transferencia)
  comprobanteDocId String?
  aplicadoEnPortal Boolean    @default(false)
  registradoPorId  String?
  registradoPor    User?      @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])
  createdAt        DateTime   @default(now())

  @@index([polizaId])
}

// ───────────────────────── Facturación y complementos ─────────────────────────

model Factura {
  id                 String        @id @default(cuid())
  // Una factura se liga por RFC al cliente; la póliza es opcional (puede venir
  // de una carga por RFC sin póliza específica).
  polizaId           String?
  poliza             Poliza?       @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  clienteId          String?
  cliente            Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  tipo               TipoDocumento // factura | complemento
  uuid               String?       // folio fiscal (UUID) del CFDI, si la IA lo leyó
  storageDocId       String?
  enviadoAlClienteEn DateTime?
  createdAt          DateTime      @default(now())

  notasCredito NotaCredito[]

  @@index([polizaId])
  @@index([clienteId])
  @@index([uuid])
}

// Nota de crédito: la IA la lee, la liga al cliente por RFC y, si trae el UUID
// de la factura relacionada, también a esa factura.
model NotaCredito {
  id              String    @id @default(cuid())
  clienteId       String?
  cliente         Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  facturaId       String?
  factura         Factura?  @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  uuidRelacionado String?
  importe         Decimal?  @db.Decimal(14, 2)
  storageDocId    String?
  createdAt       DateTime  @default(now())

  @@index([clienteId])
  @@index([facturaId])
}

// Endoso de alta/baja/cancelación, leído por IA de un documento y aplicado tras
// confirmación humana. La póliza referida se localiza por número de serie.
model Endoso {
  id           String           @id @default(cuid())
  movimiento   MovimientoEndoso
  serie        String?
  rfc          String?
  importe      Decimal?         @db.Decimal(14, 2)
  polizaId     String?
  poliza       Poliza?          @relation(fields: [polizaId], references: [id], onDelete: SetNull)
  storageDocId String?
  notas        String?
  aplicadoEn   DateTime?
  createdAt    DateTime         @default(now())

  @@index([polizaId])
  @@index([serie])
}

// ───────────────────────── Auditoría ─────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  entidad     String   // "Cliente", "Expediente", ...
  entidadId   String
  accion      String   // "create" | "update" | "delete" | "estado" | ...
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  diff        Json?
  timestamp   DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([timestamp])
}

// ───────────────────────── SINIESTROS (RESERVADO / stub) ─────────────────────────
// No se implementa lógica en esta fase. Se deja la tabla y la relación
// Poliza -> Siniestro[] para poder desarrollar el módulo sin migración destructiva.

model Siniestro {
  id          String   @id @default(cuid())
  polizaId    String
  poliza      Poliza   @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  // Campos por definir en la fase futura de Siniestros.
  createdAt   DateTime @default(now())

  @@index([polizaId])
}
